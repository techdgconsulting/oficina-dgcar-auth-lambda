DB_HOST=localhost
DB_PORT=5432
DB_NAME=oficina
DB_USERNAME=oficina
DB_PASSWORD=change-me
DB_SSL=false

CLIENT_TABLE=clientes
CLIENT_ID_COLUMN=id
CLIENT_DOCUMENT_COLUMN=documento
CLIENT_PASSWORD_HASH_COLUMN=senha_hash
# Defina como status_cliente quando a coluna existir no banco.
CLIENT_STATUS_COLUMN=
CLIENT_DEFAULT_STATUS=ATIVO
CLIENT_ALLOWED_STATUSES=ATIVO

CLIENT_JWT_SECRET=change-me-with-at-least-32-characters
CLIENT_JWT_ISSUER=oficina-dgcar-auth-lambda
CLIENT_JWT_AUDIENCE=oficina-dgcar-api
CLIENT_JWT_EXPIRES_IN=15m
